{%- paginate search.results by 24 -%}
<section class="ui-wrap ui-section">
  <h1 class="ui-section__title">{{ 'general.search_title' | t }}</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" class="ui-searchpage">
    <label class="visually-hidden" for="search-page-q">{{ 'general.search' | t }}</label>
    <input id="search-page-q" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search_placeholder' | t }}">
    <button class="ui-btn" type="submit">{{ 'general.search' | t }}</button>
  </form>
  {%- if search.performed -%}
    <p class="ui-toolbar__count">{{ 'general.search_count' | t: count: search.results_count, terms: search.terms }}</p>
    {%- if search.results.size > 0 -%}
      <div class="ui-grid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'ui-card', product: item, heading_level: 'h2' %}
          {%- else -%}
            <article class="ui-card ui-card--text">
              <h2 class="ui-card__title"><a href="{{ item.url }}">{{ item.title | escape }}</a></h2>
              <p>{{ item.content | strip_html | truncatewords: 24 }}</p>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endif -%}
  {% render 'ui-pagination', paginate: paginate %}
</section>
{%- endpaginate -%}

{% schema %}
{"name": "Search page"}
{% endschema %}
