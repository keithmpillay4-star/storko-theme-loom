<section class="ui-wrap ui-section ui-recs" data-module="recommendations" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <h2 class="ui-section__title">{{ section.settings.heading }}</h2>
    <div class="ui-grid">
      {%- for product in recommendations.products -%}{% render 'ui-card', product: product, show_vendor: section.settings.show_vendor %}{%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "You may also like"},
    {"type": "range", "id": "limit", "label": "Products", "min": 2, "max": 8, "step": 1, "default": 4},
    {"type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false}
  ]
}
{% endschema %}
