<section class="ui-wrap ui-wrap--narrow ui-section ui-richtext ui-richtext--{{ section.settings.align }}">
  {%- if section.settings.eyebrow != blank -%}<p class="ui-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
  {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
  <div class="ui-rte">{{ section.settings.text }}</div>
  {%- if section.settings.button_label != blank -%}<a class="ui-btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{%- endif -%}
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    {"type": "select", "id": "align", "label": "Alignment", "default": "center", "options": [{"value": "left", "label": "Left"}, {"value": "center", "label": "Center"}]},
    {"type": "text", "id": "eyebrow", "label": "Eyebrow"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Talk about your brand"},
    {"type": "richtext", "id": "text", "label": "Text", "default": "<p>Share information about your brand with your customers.</p>"},
    {"type": "text", "id": "button_label", "label": "Button label"},
    {"type": "url", "id": "button_link", "label": "Button link"}
  ],
  "presets": [{"name": "Rich text"}]
}
{% endschema %}
