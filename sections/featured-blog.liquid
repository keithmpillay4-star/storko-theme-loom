<section class="ui-wrap ui-section">
  <header class="ui-section__head">
    <h2 class="ui-section__title">{{ section.settings.title }}</h2>
    {%- if section.settings.blog != blank -%}<a class="ui-link" href="{{ section.settings.blog.url }}">{{ 'general.view_all' | t }}</a>{%- endif -%}
  </header>
  <div class="ui-grid ui-grid--3">
    {%- for article in section.settings.blog.articles limit: section.settings.limit -%}
      <article class="ui-post">
        {%- if article.image -%}<a href="{{ article.url }}">{{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300,500,800', sizes: '(min-width: 750px) 33vw, 100vw', alt: article.image.alt }}</a>{%- endif -%}
        <p class="ui-eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p>
        <h3 class="ui-post__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
      </article>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured blog",
  "settings": [
    {"type": "text", "id": "title", "label": "Heading", "default": "From the journal"},
    {"type": "blog", "id": "blog", "label": "Blog"},
    {"type": "range", "id": "limit", "label": "Posts", "min": 3, "max": 9, "step": 3, "default": 3}
  ],
  "presets": [{"name": "Featured blog"}]
}
{% endschema %}
