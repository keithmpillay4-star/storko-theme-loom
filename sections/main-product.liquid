{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign first_media = current_variant.featured_media | default: product.featured_media
  assign product_form_id = 'product-form-' | append: section.id
-%}
<section class="ui-wrap ui-product ui-product--{{ section.settings.gallery_layout }}" data-module="product" data-product-id="{{ product.id }}" data-section-id="{{ section.id }}">
  <div class="ui-gallery" data-gallery>
    <div class="ui-gallery__main">
      {%- for media in product.media -%}
        <div class="ui-gallery__slide{% if media.id == first_media.id %} is-active{% endif %}" data-media-id="{{ media.id }}" {% if media.id != first_media.id and section.settings.gallery_layout == 'thumbnails' %}hidden{% endif %}>
          {%- case media.media_type -%}
            {%- when 'image' -%}
              {%- assign media_loading = 'lazy' -%}
              {%- if forloop.first -%}{%- assign media_loading = 'eager' -%}{%- endif -%}
              {{ media | image_url: width: 1400 | image_tag: loading: media_loading, widths: '480,720,960,1200,1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: media.alt }}
            {%- when 'video' -%}
              {{ media | video_tag: controls: true, image_size: '1200x', loop: false }}
            {%- when 'external_video' -%}
              {{ media | external_video_tag }}
            {%- when 'model' -%}
              {{ media | model_viewer_tag }}
            {%- else -%}
              {{ media | media_tag }}
          {%- endcase -%}
        </div>
      {%- else -%}
        <div class="ui-gallery__slide is-active">{{ 'product-1' | placeholder_svg_tag }}</div>
      {%- endfor -%}
    </div>
    {%- if product.media.size > 1 and section.settings.gallery_layout == 'thumbnails' -%}
      <ul class="ui-gallery__thumbs" role="list">
        {%- for media in product.media -%}
          <li>
            <button type="button" class="ui-gallery__thumb{% if media.id == first_media.id %} is-active{% endif %}" data-thumb="{{ media.id }}" aria-label="{{ 'products.show_image' | t: index: forloop.index }}">
              {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', width: 80, alt: '' }}
            </button>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  <div class="ui-product__info">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when '@app' -%}
          {% render block %}

        {%- when 'vendor' -%}
          {%- if product.vendor != blank -%}<p class="ui-eyebrow" {{ block.shopify_attributes }}>{{ product.vendor }}</p>{%- endif -%}

        {%- when 'title' -%}
          <h1 class="ui-product__title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

        {%- when 'price' -%}
          <div class="ui-product__price" {{ block.shopify_attributes }} data-price-wrap>
            {% render 'ui-price', product: product, variant: current_variant %}
          </div>

        {%- when 'description' -%}
          {%- if product.description != blank -%}<div class="ui-rte ui-product__desc" {{ block.shopify_attributes }}>{{ product.description }}</div>{%- endif -%}

        {%- when 'variant_picker' -%}
          {%- unless product.has_only_default_variant -%}
            <div class="ui-variants" {{ block.shopify_attributes }} data-variants>
              {%- for option in product.options_with_values -%}
                <fieldset class="ui-option" data-option-index="{{ forloop.index0 }}">
                  <legend>{{ option.name }}</legend>
                  {%- if block.settings.picker_type == 'dropdown' -%}
                    <select class="ui-select" name="options[{{ option.name | escape }}]" data-option-select>
                      {%- for value in option.values -%}<option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>{%- endfor -%}
                    </select>
                  {%- else -%}
                    <div class="ui-option__values">
                      {%- for value in option.values -%}
                        <input type="radio" id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}" name="{{ section.id }}-option-{{ option.position }}" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %} data-option-radio>
                        <label for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}" class="ui-pill">{{ value }}</label>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </fieldset>
              {%- endfor -%}
              <script type="application/json" data-variants-json>{{ product.variants | json }}</script>
            </div>
          {%- endunless -%}

        {%- when 'quantity' -%}
          <div class="ui-qtywrap" {{ block.shopify_attributes }}>
            <label for="qty-{{ section.id }}">{{ 'cart.quantity' | t }}</label>
            <div class="ui-qty" data-qty>
              <button type="button" class="ui-qty__btn" data-qty-minus aria-label="{{ 'cart.decrease' | t }}">{% render 'ui-icon', name: 'minus' %}</button>
              <input id="qty-{{ section.id }}" class="ui-qty__input" type="number" name="quantity" min="1" value="1" form="product-form-{{ section.id }}" data-qty-input>
              <button type="button" class="ui-qty__btn" data-qty-plus aria-label="{{ 'cart.increase' | t }}">{% render 'ui-icon', name: 'plus' %}</button>
            </div>
          </div>

        {%- when 'buy_buttons' -%}
          <div class="ui-buy" {{ block.shopify_attributes }}>
            {%- form 'product', product, id: product_form_id, class: 'ui-buy__form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
              <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
              <button type="submit" class="ui-btn ui-btn--block" name="add" data-add-button{% unless current_variant.available %} disabled{% endunless %}>
                <span data-add-label>{%- if current_variant.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}</span>
              </button>
              {%- if block.settings.show_dynamic_checkout -%}{{ form | payment_button }}{%- endif -%}
              <p class="ui-form-error" role="alert" data-form-error hidden></p>
            {%- endform -%}
          </div>

        {%- when 'collapsible_tab' -%}
          <details class="ui-tab" {{ block.shopify_attributes }}>
            <summary>{{ block.settings.heading | default: block.settings.page.title }}{% render 'ui-icon', name: 'chevron' %}</summary>
            <div class="ui-rte">{{ block.settings.content }}{{ block.settings.page.content }}</div>
          </details>

        {%- when 'trust' -%}
          <ul class="ui-trust" {{ block.shopify_attributes }}>
            {%- for i in (1..3) -%}
              {%- assign t_key = 'text_' | append: i -%}
              {%- assign i_key = 'icon_' | append: i -%}
              {%- if block.settings[t_key] != blank -%}<li>{% render 'ui-icon', name: block.settings[i_key] %}<span>{{ block.settings[t_key] }}</span></li>{%- endif -%}
            {%- endfor -%}
          </ul>

        {%- when 'share' -%}
          <div class="ui-share" {{ block.shopify_attributes }}>
            <button type="button" class="ui-linkbtn" data-copy-link="{{ shop.url }}{{ product.url }}">{{ 'products.copy_link' | t }}</button>
          </div>

        {%- when 'pickup' -%}
          {%- if current_variant.store_availabilities.size > 0 -%}
            <p class="ui-pickup" {{ block.shopify_attributes }}>{{ 'products.pickup_available' | t }}</p>
          {%- endif -%}
          {%- comment -%}EXTRA_PRODUCT_CASE{%- endcomment -%}

      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Product",
  "tag": "div",
  "settings": [
    {"type": "select", "id": "gallery_layout", "label": "Gallery layout", "default": "thumbnails", "options": [
      {"value": "thumbnails", "label": "Thumbnails"},
      {"value": "stacked", "label": "Stacked"}
    ]}
  ],
  "blocks": [
    {"type": "@app"},
    {"type": "vendor", "name": "Vendor", "limit": 1},
    {"type": "title", "name": "Title", "limit": 1},
    {"type": "price", "name": "Price", "limit": 1},
    {"type": "description", "name": "Description", "limit": 1},
    {"type": "variant_picker", "name": "Variant picker", "limit": 1, "settings": [
      {"type": "select", "id": "picker_type", "label": "Style", "default": "buttons", "options": [
        {"value": "buttons", "label": "Buttons"}, {"value": "dropdown", "label": "Dropdown"}
      ]}
    ]},
    {"type": "quantity", "name": "Quantity", "limit": 1},
    {"type": "buy_buttons", "name": "Buy buttons", "limit": 1, "settings": [
      {"type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout buttons", "default": true}
    ]},
    {"type": "collapsible_tab", "name": "Collapsible tab", "settings": [
      {"type": "text", "id": "heading", "label": "Heading", "default": "Details"},
      {"type": "richtext", "id": "content", "label": "Content"},
      {"type": "page", "id": "page", "label": "Content from page"}
    ]},
    {"type": "trust", "name": "Trust badges", "limit": 1, "settings": [
      {"type": "select", "id": "icon_1", "label": "Icon 1", "default": "truck", "options": [{"value": "truck", "label": "Truck"}, {"value": "shield", "label": "Shield"}, {"value": "return", "label": "Return"}, {"value": "check", "label": "Check"}, {"value": "star", "label": "Star"}]},
      {"type": "text", "id": "text_1", "label": "Text 1", "default": "Fast delivery"},
      {"type": "select", "id": "icon_2", "label": "Icon 2", "default": "return", "options": [{"value": "truck", "label": "Truck"}, {"value": "shield", "label": "Shield"}, {"value": "return", "label": "Return"}, {"value": "check", "label": "Check"}, {"value": "star", "label": "Star"}]},
      {"type": "text", "id": "text_2", "label": "Text 2", "default": "Easy returns"},
      {"type": "select", "id": "icon_3", "label": "Icon 3", "default": "shield", "options": [{"value": "truck", "label": "Truck"}, {"value": "shield", "label": "Shield"}, {"value": "return", "label": "Return"}, {"value": "check", "label": "Check"}, {"value": "star", "label": "Star"}]},
      {"type": "text", "id": "text_3", "label": "Text 3", "default": "Secure checkout"}
    ]},
    {"type": "share", "name": "Share", "limit": 1},
    {"type": "pickup", "name": "Pickup availability", "limit": 1}
  ]
}
{% endschema %}
