<section class="ui-wrap ui-section">
  <header class="ui-section__head">
    {%- if section.settings.title != blank -%}<h2 class="ui-section__title">{{ section.settings.title }}</h2>{%- endif -%}
    {%- if section.settings.collection != blank and section.settings.show_view_all -%}<a class="ui-link" href="{{ section.settings.collection.url }}">{{ 'general.view_all' | t }}</a>{%- endif -%}
  </header>
  <div class="ui-grid ui-grid--{{ section.settings.columns }}">
    {%- if section.settings.collection != blank -%}
      {%- for product in section.settings.collection.products limit: section.settings.limit -%}
        {% render 'ui-card', product: product, show_vendor: section.settings.show_vendor %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..section.settings.columns) -%}
        <article class="ui-card"><div class="ui-card__media"><div class="ui-card__placeholder">{{ 'product-1' | placeholder_svg_tag }}</div></div><div class="ui-card__body"><h3 class="ui-card__title">{{ 'products.example_title' | t }}</h3></div></article>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {"type": "text", "id": "title", "label": "Heading", "default": "Featured collection"},
    {"type": "collection", "id": "collection", "label": "Collection"},
    {"type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 16, "step": 1, "default": 8},
    {"type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 5, "step": 1, "default": 4},
    {"type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false},
    {"type": "checkbox", "id": "show_view_all", "label": "Show 'View all' link", "default": true}
  ],
  "presets": [{"name": "Featured collection"}]
}
{% endschema %}
