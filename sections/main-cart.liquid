<section class="ui-wrap ui-section ui-cartpage" data-cart-page>
  <h1 class="ui-section__title">{{ 'cart.title' | t }}</h1>
  {%- if cart.item_count == 0 -%}
    <div class="ui-drawer__empty">
      <p>{{ 'cart.empty' | t }}</p>
      <a class="ui-btn" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" id="cart-form" class="ui-cartpage__grid">
      <ul class="ui-lines">
        {%- for item in cart.items -%}
          <li class="ui-line" data-line="{{ forloop.index }}">
            <a class="ui-line__img" href="{{ item.url }}">{%- if item.image -%}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', width: 120, alt: item.image.alt }}{%- endif -%}</a>
            <div class="ui-line__info">
              <a class="ui-line__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>
              {%- unless item.product.has_only_default_variant -%}<p class="ui-line__variant">{{ item.variant.title }}</p>{%- endunless -%}
              {%- for discount in item.line_level_discount_allocations -%}<p class="ui-line__variant">{{ discount.discount_application.title }} (-{{ discount.amount | money }})</p>{%- endfor -%}
              <div class="ui-line__row">
                <div class="ui-qty" data-qty>
                  <button type="button" class="ui-qty__btn" data-qty-minus aria-label="{{ 'cart.decrease' | t }}">{% render 'ui-icon', name: 'minus' %}</button>
                  <input class="ui-qty__input" type="number" name="updates[]" min="0" value="{{ item.quantity }}" aria-label="{{ 'cart.quantity' | t }}" data-qty-input>
                  <button type="button" class="ui-qty__btn" data-qty-plus aria-label="{{ 'cart.increase' | t }}">{% render 'ui-icon', name: 'plus' %}</button>
                </div>
                <span class="ui-line__price">{{ item.final_line_price | money }}</span>
              </div>
            </div>
            <a class="ui-iconbtn ui-line__remove" href="{{ item.url_to_remove }}">{% render 'ui-icon', name: 'close' %}<span class="visually-hidden">{{ 'cart.remove' | t }}</span></a>
          </li>
        {%- endfor -%}
      </ul>

      <div class="ui-cartpage__summary">
        <label for="cart-note">{{ 'cart.note' | t }}</label>
        <textarea id="cart-note" name="note" rows="3">{{ cart.note }}</textarea>
        <p class="ui-drawer__total"><span>{{ 'cart.subtotal' | t }}</span> <strong>{{ cart.total_price | money }}</strong></p>
        <p class="ui-drawer__note">{{ 'cart.taxes_shipping' | t }}</p>
        <button type="submit" class="ui-btn ui-btn--ghost ui-btn--block" name="update">{{ 'cart.update' | t }}</button>
        <button type="submit" class="ui-btn ui-btn--block" name="checkout">{{ 'cart.checkout' | t }}</button>
      </div>
    </form>
  {%- endif -%}
</section>

{% schema %}
{"name": "Cart page"}
{% endschema %}
