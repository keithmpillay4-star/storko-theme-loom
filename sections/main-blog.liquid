{%- paginate blog.articles by 9 -%}
<section class="ui-wrap ui-section">
  <h1 class="ui-section__title">{{ blog.title }}</h1>
  {%- if blog.all_tags.size > 0 -%}
    <ul class="ui-tags" role="list">
      <li><a href="{{ blog.url }}" class="ui-pill{% unless current_tags %} is-active{% endunless %}">{{ 'general.all' | t }}</a></li>
      {%- for tag in blog.all_tags -%}<li><a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="ui-pill{% if current_tags contains tag %} is-active{% endif %}">{{ tag }}</a></li>{%- endfor -%}
    </ul>
  {%- endif -%}
  <div class="ui-grid ui-grid--3">
    {%- for article in blog.articles -%}
      <article class="ui-post">
        {%- if article.image -%}<a href="{{ article.url }}">{{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300,500,800', sizes: '(min-width: 750px) 33vw, 100vw', alt: article.image.alt }}</a>{%- endif -%}
        <p class="ui-eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p>
        <h2 class="ui-post__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
        <p>{{ article.excerpt_or_content | strip_html | truncatewords: 28 }}</p>
      </article>
    {%- endfor -%}
  </div>
  {% render 'ui-pagination', paginate: paginate %}
</section>
{%- endpaginate -%}

{% schema %}
{"name": "Blog"}
{% endschema %}
