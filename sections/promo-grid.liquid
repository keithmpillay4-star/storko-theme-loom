<section class="ui-wrap ui-section">
  {%- if section.settings.title != blank -%}<h2 class="ui-section__title">{{ section.settings.title }}</h2>{%- endif -%}
  <div class="loom-promos loom-promos--{{ section.blocks.size }}">
    {%- for block in section.blocks -%}
      <a class="loom-promo" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,700,1000', sizes: '(min-width: 990px) 33vw, 100vw', alt: block.settings.image.alt }}
        {%- else -%}
          <span class="loom-promo__ph">{{ 'image' | placeholder_svg_tag }}</span>
        {%- endif -%}
        <span class="loom-promo__text">
          {%- if block.settings.eyebrow != blank -%}<span class="ui-eyebrow">{{ block.settings.eyebrow }}</span>{%- endif -%}
          <strong>{{ block.settings.heading }}</strong>
          {%- if block.settings.label != blank -%}<span class="loom-promo__cta">{{ block.settings.label }} &rarr;</span>{%- endif -%}
        </span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Promo grid",
  "max_blocks": 4,
  "settings": [{"type": "text", "id": "title", "label": "Heading"}],
  "blocks": [
    {"type": "promo", "name": "Promo tile", "settings": [
      {"type": "image_picker", "id": "image", "label": "Image"},
      {"type": "text", "id": "eyebrow", "label": "Eyebrow"},
      {"type": "text", "id": "heading", "label": "Heading", "default": "Promo heading"},
      {"type": "text", "id": "label", "label": "Link label", "default": "Shop now"},
      {"type": "url", "id": "link", "label": "Link"}
    ]}
  ],
  "presets": [{"name": "Promo grid", "blocks": [{"type": "promo"}, {"type": "promo"}, {"type": "promo"}]}]
}
{% endschema %}
