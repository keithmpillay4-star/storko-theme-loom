<section class="ui-wrap ui-section">
  {%- if section.settings.title != blank -%}<h2 class="ui-section__title">{{ section.settings.title }}</h2>{%- endif -%}
  <ul class="ui-cols ui-cols--{{ section.settings.columns }}" role="list">
    {%- for block in section.blocks -%}
      <li class="ui-col" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200,400,600', sizes: '(min-width: 750px) 33vw, 100vw', alt: block.settings.image.alt }}
        {%- elsif block.settings.icon != 'none' -%}<span class="ui-col__icon">{% render 'ui-icon', name: block.settings.icon %}</span>{%- endif -%}
        {%- if block.settings.heading != blank -%}<h3>{{ block.settings.heading }}</h3>{%- endif -%}
        {%- if block.settings.text != blank -%}<div class="ui-rte">{{ block.settings.text }}</div>{%- endif -%}
        {%- if block.settings.link_label != blank -%}<a class="ui-link" href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>{%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Multicolumn",
  "settings": [
    {"type": "text", "id": "title", "label": "Heading", "default": "Why shop with us"},
    {"type": "range", "id": "columns", "label": "Columns (desktop)", "min": 1, "max": 5, "step": 1, "default": 3}
  ],
  "blocks": [
    {"type": "column", "name": "Column", "settings": [
      {"type": "image_picker", "id": "image", "label": "Image"},
      {"type": "select", "id": "icon", "label": "Icon (when no image)", "default": "none", "options": [
        {"value": "none", "label": "None"}, {"value": "truck", "label": "Truck"}, {"value": "shield", "label": "Shield"}, {"value": "return", "label": "Return"}, {"value": "check", "label": "Check"}, {"value": "star", "label": "Star"}, {"value": "mail", "label": "Mail"}, {"value": "download", "label": "Download"}
      ]},
      {"type": "text", "id": "heading", "label": "Heading", "default": "Column"},
      {"type": "richtext", "id": "text", "label": "Text", "default": "<p>Pair text with an image or icon.</p>"},
      {"type": "text", "id": "link_label", "label": "Link label"},
      {"type": "url", "id": "link", "label": "Link"}
    ]}
  ],
  "presets": [{"name": "Multicolumn", "blocks": [{"type": "column"}, {"type": "column"}, {"type": "column"}]}]
}
{% endschema %}
