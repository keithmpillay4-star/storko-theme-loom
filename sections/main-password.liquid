<section class="ui-wrap ui-wrap--narrow ui-section ui-center ui-password">
  <h1>{{ shop.name }}</h1>
  {%- if shop.password_message != blank -%}<div class="ui-rte">{{ shop.password_message }}</div>{%- endif -%}
  {% form 'storefront_password' %}
    {%- if form.errors -%}<p class="ui-form-error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
    <label for="password-field">{{ 'general.password' | t }}</label>
    <input id="password-field" type="password" name="password" autocomplete="current-password" required>
    <button class="ui-btn" type="submit">{{ 'general.enter' | t }}</button>
  {% endform %}
  {% form 'customer' %}
    <h2>{{ 'general.notify_me' | t }}</h2>
    <label for="pw-email">{{ 'general.email' | t }}</label>
    <input id="pw-email" type="email" name="contact[email]" required>
    <button class="ui-btn ui-btn--ghost" type="submit">{{ 'general.subscribe' | t }}</button>
    {%- if form.posted_successfully? -%}<p class="ui-form-ok" role="status">{{ 'general.subscribed' | t }}</p>{%- endif -%}
  {% endform %}
</section>

{% schema %}
{"name": "Password page"}
{% endschema %}
