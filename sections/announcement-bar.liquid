<div class="ui-announce" role="region" aria-label="{{ 'general.announcement' | t }}">
  <div class="ui-wrap ui-announce__inner">
    {%- for block in section.blocks -%}
      <p class="ui-announce__item" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
      </p>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 3,
  "blocks": [
    {"type": "message", "name": "Message", "settings": [
      {"type": "text", "id": "text", "label": "Text", "default": "Welcome to our store"},
      {"type": "url", "id": "link", "label": "Link"}
    ]}
  ],
  "presets": [{"name": "Announcement bar", "blocks": [{"type": "message"}]}]
}
{% endschema %}
