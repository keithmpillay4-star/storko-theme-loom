<section class="loom-marquee" aria-label="{{ section.settings.text | escape }}">
  <div class="loom-marquee__track">
    {%- for i in (1..4) -%}<span aria-hidden="{% if i > 1 %}true{% else %}false{% endif %}">{{ section.settings.text }}</span>{%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Marquee text",
  "settings": [{"type": "text", "id": "text", "label": "Text", "default": "Free shipping on orders over R1000 • New arrivals weekly • "}],
  "presets": [{"name": "Marquee text"}]
}
{% endschema %}
