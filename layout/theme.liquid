<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_accent }}">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  {%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">{%- endif -%}

  <title>{{ page_title | escape }}{% if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  {% render 'meta-tags' %}

  {% render 'ui-tokens' %}
  {{ 'core.css' | asset_url | stylesheet_tag }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <script>
    document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    window.theme = {
      routes: {
        cart: {{ routes.cart_url | json }},
        cartAdd: {{ routes.cart_add_url | json }},
        cartChange: {{ routes.cart_change_url | json }},
        cartUpdate: {{ routes.cart_update_url | json }},
        search: {{ routes.search_url | json }},
        suggest: {{ routes.predictive_search_url | json }},
        root: {{ routes.root_url | json }}
      },
      cartType: {{ settings.cart_type | json }},
      strings: {
        added: {{ 'cart.added' | t | json }},
        cartUpdated: {{ 'cart.updated' | t | json }},
        error: {{ 'cart.error' | t | json }},
        soldOut: {{ 'products.sold_out' | t | json }},
        unavailable: {{ 'products.unavailable' | t | json }},
        addToCart: {{ 'products.add_to_cart' | t | json }}
      }
    };
  </script>
  <script src="{{ 'core.js' | asset_url }}" type="module"></script>
  <script src="{{ 'theme.js' | asset_url }}" type="module"></script>

  {{ content_for_header }}
</head>
<body class="template-{{ request.page_type | handleize }}">
  <a class="ui-skip" href="#main">{{ 'general.skip' | t }}</a>

  {% sections 'header-group' %}

  <main id="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% if settings.cart_type == 'drawer' and request.page_type != 'cart' %}
    {% section 'cart-drawer' %}
  {% endif %}
  {% render 'ui-toast' %}
</body>
</html>
