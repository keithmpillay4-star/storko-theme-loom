<section class="ui-wrap ui-wrap--narrow ui-section">
  <h1 class="ui-section__title">{{ 'customer.reset_title' | t }}</h1>
  {% form 'reset_customer_password', class: 'ui-form' %}
    {%- if form.errors -%}<p class="ui-form-error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
    <label for="rp-pass">{{ 'general.password' | t }}</label>
    <input id="rp-pass" type="password" name="customer[password]" autocomplete="new-password" required>
    <label for="rp-conf">{{ 'customer.confirm_password' | t }}</label>
    <input id="rp-conf" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
    <button class="ui-btn" type="submit">{{ 'customer.reset_submit' | t }}</button>
  {% endform %}
</section>
