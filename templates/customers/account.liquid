<section class="ui-wrap ui-section">
  <header class="ui-section__head">
    <h1 class="ui-section__title">{{ 'customer.account' | t }}</h1>
    <a class="ui-link" href="{{ routes.account_logout_url }}">{{ 'customer.logout' | t }}</a>
  </header>
  <div class="ui-account">
    <div>
      <h2>{{ 'customer.orders' | t }}</h2>
      {%- paginate customer.orders by 20 -%}
        {%- if customer.orders.size > 0 -%}
          <table class="ui-table">
            <thead><tr><th scope="col">{{ 'customer.order' | t }}</th><th scope="col">{{ 'customer.date' | t }}</th><th scope="col">{{ 'customer.payment' | t }}</th><th scope="col">{{ 'customer.fulfillment' | t }}</th><th scope="col">{{ 'customer.total' | t }}</th></tr></thead>
            <tbody>
              {%- for order in customer.orders -%}
                <tr>
                  <th scope="row"><a href="{{ order.customer_url }}">{{ order.name }}</a></th>
                  <td>{{ order.created_at | time_tag: format: 'date' }}</td>
                  <td>{{ order.financial_status_label }}</td>
                  <td>{{ order.fulfillment_status_label }}</td>
                  <td>{{ order.total_price | money }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        {%- else -%}
          <p>{{ 'customer.no_orders' | t }}</p>
        {%- endif -%}
        {% render 'ui-pagination', paginate: paginate %}
      {%- endpaginate -%}
    </div>
    <aside>
      <h2>{{ 'customer.details' | t }}</h2>
      <p>{{ customer.name }}<br>{{ customer.email }}</p>
      {%- if customer.default_address -%}<address>{{ customer.default_address | format_address }}</address>{%- endif -%}
      <a class="ui-link" href="{{ routes.account_addresses_url }}">{{ 'customer.addresses' | t }} ({{ customer.addresses_count }})</a>
    </aside>
  </div>
</section>
